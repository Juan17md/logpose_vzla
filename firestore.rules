rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ========================================
    // 🔐 HELPERS DE AUTORIZACIÓN
    // ========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnerFromResource() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isOwnerFromRequest() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function keepsSameUserId() {
      return request.resource.data.userId == resource.data.userId;
    }

    // ========================================
    // 🛡️ HELPERS DE RBAC
    // ========================================
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function hasRole(userId, role) {
      return isSignedIn() && getUserData(userId).role == role;
    }

    function isAdmin() {
      return isSignedIn() && hasRole(request.auth.uid, "admin");
    }

    function getUserStatus(userId) {
      return getUserData(userId).status;
    }

    function isNotExpired(userId) {
      return getUserStatus(userId) != "expired";
    }

    // ========================================
    // 📋 REGLAS DE SEGURIDAD - CONTROL DE GASTOS
    // ========================================

    // ----------------------------------------
    // 👤 USUARIOS - Documento principal del usuario
    // ----------------------------------------
    // Colección: users/{userId}
    // El propietario siempre puede leer/escribir su propio documento.
    // Los administradores pueden leer todos los users para el panel admin.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Subcolecciones: ownership estricto
      match /debts/{debtId} {
        allow read, write: if isOwner(userId) && isNotExpired(userId);
      }

      match /fixed_expenses/{expenseId} {
        allow read, write: if isOwner(userId) && isNotExpired(userId);
      }

      match /saving_goals/{goalId} {
        allow read, write: if isOwner(userId) && isNotExpired(userId);
      }

      match /savings_transactions/{transactionId} {
        allow read, write: if isOwner(userId) && isNotExpired(userId);
      }

      match /bank_accounts/{accountId} {
        allow read, write: if isOwner(userId) && isNotExpired(userId);
      }

      match /account_transactions/{transId} {
        allow read, write: if isOwner(userId) && isNotExpired(userId);
      }

      match /categories/{categoryId} {
        allow read, write: if isOwner(userId) && isNotExpired(userId);
      }
    }

    // ----------------------------------------
    // 💵 TRANSACCIONES - Ingresos y gastos
    // ----------------------------------------
    match /transactions/{transactionId} {
      allow read: if isOwnerFromResource();
      allow create: if isOwnerFromRequest();
      allow update: if isOwnerFromResource() && isOwnerFromRequest() && keepsSameUserId();
      allow delete: if isOwnerFromResource();
    }

    // ----------------------------------------
    // 🛒 LISTAS DE COMPRAS - Shopping lists
    // ----------------------------------------
    match /shopping_lists/{listId} {
      allow read: if isOwnerFromResource();
      allow create: if isOwnerFromRequest();
      allow update: if isOwnerFromResource() && isOwnerFromRequest() && keepsSameUserId();
      allow delete: if isOwnerFromResource();
    }

  }
}
