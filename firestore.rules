rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ========================================
    // 🔐 HELPERS DE AUTORIZACIÓN
    // ========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnerFromResource() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isOwnerFromRequest() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function keepsSameUserId() {
      return request.resource.data.userId == resource.data.userId;
    }

    // ========================================
    // ✅ HELPERS DE VALIDACIÓN DE DATOS
    // ========================================
    function isString(value) {
      return value is string;
    }

    function isNumber(value) {
      return value is number;
    }

    function isBoolean(value) {
      return value is bool;
    }

    // Validación condicional: si el campo está presente en un update, debe tener el tipo correcto.
    function validStringIfPresent(field) {
      return !(field in request.resource.data) || isString(request.resource.data[field]);
    }

    function validNumberIfPresent(field) {
      return !(field in request.resource.data) || isNumber(request.resource.data[field]);
    }

    function validBooleanIfPresent(field) {
      return !(field in request.resource.data) || isBoolean(request.resource.data[field]);
    }

    // Montos de saldo/progreso no pueden ser negativos (si el campo está presente).
    function validNonNegativeIfPresent(field) {
      return !(field in request.resource.data)
        || (isNumber(request.resource.data[field])
            && request.resource.data[field] >= 0);
    }

    function isValidType(type) {
      return type == "ingreso" || type == "gasto" || type == "transferencia";
    }

    function isValidTransactionCurrency(currency) {
      return currency == "VES" || currency == "USD";
    }

    function isValidAccountCurrency(currency) {
      return currency == "BS" || currency == "USD" || currency == "EUR" || currency == "USDT";
    }

    function validTypeIfPresent() {
      return !("type" in request.resource.data)
        || (isString(request.resource.data.type) && isValidType(request.resource.data.type));
    }

    function validTransactionCurrencyIfPresent() {
      return !("currency" in request.resource.data)
        || (isString(request.resource.data.currency)
            && isValidTransactionCurrency(request.resource.data.currency));
    }

    function validAccountCurrencyIfPresent() {
      return !("moneda" in request.resource.data)
        || (isString(request.resource.data.moneda)
            && isValidAccountCurrency(request.resource.data.moneda));
    }

    // ========================================
    // 🛡️ HELPERS DE RBAC
    // ========================================
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function hasRole(userId, role) {
      return isSignedIn() && getUserData(userId).role == role;
    }

    function isAdmin() {
      return isSignedIn() && hasRole(request.auth.uid, "admin");
    }

    // El rol no puede mutar desde el SDK cliente (ni el dueño ni un admin).
    // Promociones y degradaciones: Server Actions con service account (omite rules).
    function keepsSameRole() {
      return request.resource.data.role == resource.data.role;
    }

    // ========================================
    // 📋 REGLAS DE SEGURIDAD - LOGPOSE VZLA
    // ========================================

    // ----------------------------------------
    // 👤 USUARIOS - Documento principal del usuario
    // ----------------------------------------
    // Colección: users/{userId}
    // El propietario lee y actualiza su documento (sin cambiar role).
    // Los administradores leen todos los users (panel). El update NO usa isAdmin():
    // un admin autenticado en el cliente no puede promover a otros ni reescribir
    // perfiles ajenos. Nombre y rol de terceros: Server Actions (Admin REST).
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && isString(request.resource.data.email)
        && isString(request.resource.data.displayName)
        && request.resource.data.role == "usuario";
      allow update: if isOwner(userId) && keepsSameRole();
      allow delete: if isAdmin();

      // ----------------------------------------
      // 🏦 CUENTAS BANCARIAS - users/{userId}/bank_accounts
      // Modelo: nombre, banco, moneda (BS/USD/EUR/USDT), saldo,
      //         color, activa, excluirDelTotal, creadoEn, actualizadoEn
      // ----------------------------------------
      match /bank_accounts/{accountId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isString(request.resource.data.nombre)
          && isString(request.resource.data.banco)
          && isString(request.resource.data.moneda)
          && isValidAccountCurrency(request.resource.data.moneda)
          && isNumber(request.resource.data.saldo)
          && isString(request.resource.data.color)
          && isBoolean(request.resource.data.activa);
        allow update: if isOwner(userId)
          && validStringIfPresent("nombre")
          && validStringIfPresent("banco")
          && validAccountCurrencyIfPresent()
          && validNumberIfPresent("saldo")
          && validStringIfPresent("color")
          && validBooleanIfPresent("activa")
          && validBooleanIfPresent("excluirDelTotal");
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // 💸 OPERACIONES DE CUENTA - users/{userId}/account_transactions
      // Modelo: cuentaOrigenId, cuentaDestinoId, tipo, monto, moneda,
      //         comision, tasaCambio, descripcion, fecha, creadoEn
      // ----------------------------------------
      match /account_transactions/{transId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isString(request.resource.data.cuentaOrigenId)
          && isString(request.resource.data.tipo)
          && isNumber(request.resource.data.monto)
          && isString(request.resource.data.moneda)
          && isValidAccountCurrency(request.resource.data.moneda);
        allow update: if isOwner(userId)
          && validStringIfPresent("cuentaOrigenId")
          && validStringIfPresent("tipo")
          && validNumberIfPresent("monto")
          && validStringIfPresent("moneda");
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // 🗂️ CATEGORÍAS - users/{userId}/categories
      // Modelo: nombre, tipo (ingreso/gasto/ambas), icono,
      //         subcategorias, esPredeterminada, color, creadoEn
      // ----------------------------------------
      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isString(request.resource.data.nombre)
          && isString(request.resource.data.tipo);
        allow update: if isOwner(userId)
          && validStringIfPresent("nombre")
          && validStringIfPresent("tipo")
          && validStringIfPresent("icono")
          && validBooleanIfPresent("esPredeterminada");
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // 💳 DEUDAS - users/{userId}/debts
      // Modelo: personName, type (por_cobrar/por_pagar), amount,
      //         description, dueDate, currency, originalAmount,
      //         exchangeRate, payments, isPaid, createdAt
      // ----------------------------------------
      match /debts/{debtId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isString(request.resource.data.personName)
          && isNumber(request.resource.data.amount);
        allow update: if isOwner(userId)
          && validStringIfPresent("personName")
          && validNumberIfPresent("amount")
          && validBooleanIfPresent("isPaid");
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // 💼 GASTOS FIJOS - users/{userId}/fixed_expenses
      // Modelo: title, amount, currency (USD/BS), category,
      //         dueDay, description, lastPaidDate, createdAt
      // ----------------------------------------
      match /fixed_expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isString(request.resource.data.title)
          && isNumber(request.resource.data.amount)
          && isNumber(request.resource.data.dueDay);
        allow update: if isOwner(userId)
          && validStringIfPresent("title")
          && validNumberIfPresent("amount")
          && validNumberIfPresent("dueDay")
          && validStringIfPresent("currency")
          && validStringIfPresent("category");
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // 🎯 METAS DE AHORRO - users/{userId}/saving_goals
      // Modelo: name, targetAmount, currentAmount, deadline,
      //         color, createdAt
      // ----------------------------------------
      match /saving_goals/{goalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isString(request.resource.data.name)
          && isNumber(request.resource.data.targetAmount)
          && validNonNegativeIfPresent("currentAmount");
        allow update: if isOwner(userId)
          && validStringIfPresent("name")
          && validNumberIfPresent("targetAmount")
          && validNonNegativeIfPresent("currentAmount")
          && validStringIfPresent("color");
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // 🏦 MOVIMIENTOS DE AHORRO - users/{userId}/savings_transactions
      // Modelo: amount, type (deposit/withdrawal), method
      //         (physical/usdt/bs), description, date
      // ----------------------------------------
      match /savings_transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isNumber(request.resource.data.amount);
        allow update: if isOwner(userId)
          && validNumberIfPresent("amount")
          && validStringIfPresent("type")
          && validStringIfPresent("method");
        allow delete: if isOwner(userId);
      }
    }

    // ----------------------------------------
    // 💵 TRANSACCIONES - Ingresos y gastos (colección raíz)
    // Modelo: userId, amount, type (ingreso/gasto/transferencia),
    //         category, subcategory, description, date, currency,
    //         originalAmount, exchangeRate, accountId,
    //         targetAccountId, period, createdAt
    // ----------------------------------------
    match /transactions/{transactionId} {
      allow read: if isOwnerFromResource();
      allow create: if isOwnerFromRequest()
        && isNumber(request.resource.data.amount)
        && isValidType(request.resource.data.type)
        && isString(request.resource.data.category)
        && isString(request.resource.data.description)
        && isString(request.resource.data.currency)
        && isValidTransactionCurrency(request.resource.data.currency);
      allow update: if isOwnerFromResource() && isOwnerFromRequest() && keepsSameUserId()
        && validNumberIfPresent("amount")
        && validTypeIfPresent()
        && validStringIfPresent("category")
        && validStringIfPresent("description")
        && validTransactionCurrencyIfPresent();
      allow delete: if isOwnerFromResource();
    }

    // ----------------------------------------
    // 📋 LOGS DE ADMINISTRACIÓN - Auditoría
    // Modelo: action, adminUid, adminEmail, targetUid,
    //         targetEmail, details, timestamp (ISO 8601)
    // ----------------------------------------
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && isString(request.resource.data.action)
        && isString(request.resource.data.adminUid)
        && isString(request.resource.data.adminEmail)
        && isString(request.resource.data.targetUid)
        && isString(request.resource.data.targetEmail)
        && isString(request.resource.data.details)
        && isString(request.resource.data.timestamp);
    }

    // ----------------------------------------
    // 🛒 LISTAS DE COMPRAS - Shopping lists (colección raíz)
    // Modelo: userId, name, items, createdAt
    // ----------------------------------------
    match /shopping_lists/{listId} {
      allow read: if isOwnerFromResource();
      allow create: if isOwnerFromRequest()
        && isString(request.resource.data.name);
      allow update: if isOwnerFromResource() && isOwnerFromRequest() && keepsSameUserId()
        && validStringIfPresent("name");
      allow delete: if isOwnerFromResource();
    }

  }
}
