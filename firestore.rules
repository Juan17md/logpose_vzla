rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ========================================
    // 🔐 HELPERS DE AUTORIZACIÓN
    // ========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnerFromResource() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isOwnerFromRequest() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function keepsSameUserId() {
      return request.resource.data.userId == resource.data.userId;
    }

    // ========================================
    // ✅ HELPERS DE VALIDACIÓN DE DATOS
    // ========================================
    function isString(value) {
      return value is string;
    }

    function isNumber(value) {
      return value is number;
    }

    function isBoolean(value) {
      return value is boolean;
    }

    function isTimestamp(value) {
      return value is timestamp;
    }

    function isValidRole(role) {
      return role == "user" || role == "admin";
    }

    function isValidStatus(status) {
      return status == "active" || status == "expired" || status == "pending";
    }

    function isValidType(type) {
      return type == "income" || type == "expense";
    }

    function isValidCurrency(currency) {
      return currency == "VES" || currency == "USD";
    }

    function fieldsMatch(expected, actual) {
      return expected.keys().hasAll(actual.keys());
    }

    // ========================================
    // 🛡️ HELPERS DE RBAC
    // ========================================
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function hasRole(userId, role) {
      return isSignedIn() && getUserData(userId).role == role;
    }

    function isAdmin() {
      return isSignedIn() && hasRole(request.auth.uid, "admin");
    }

    function getUserStatus(userId) {
      return getUserData(userId).status;
    }

    function isNotExpired(userId) {
      return getUserStatus(userId) != "expired";
    }

    // ========================================
    // 📋 REGLAS DE SEGURIDAD - CONTROL DE GASTOS
    // ========================================

    // ----------------------------------------
    // 👤 USUARIOS - Documento principal del usuario
    // ----------------------------------------
    // Colección: users/{userId}
    // El propietario siempre puede leer/escribir su propio documento.
    // Los administradores pueden leer todos los users para el panel admin.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && isString(request.resource.data.email)
        && isString(request.resource.data.displayName)
        && isValidRole(request.resource.data.role)
        && isValidStatus(request.resource.data.status);
      allow update: if (isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status)
        || isAdmin();
      allow delete: if isAdmin();

      // Subcolecciones: ownership estricto
      match /debts/{debtId} {
        allow read: if isOwner(userId) && isNotExpired(userId);
        allow create: if isOwner(userId) && isNotExpired(userId)
          && isString(request.resource.data.personName)
          && isNumber(request.resource.data.amount);
        allow update: if isOwner(userId) && isNotExpired(userId)
          && isString(request.resource.data.personName)
          && isNumber(request.resource.data.amount);
        allow delete: if isOwner(userId) && isNotExpired(userId);
      }

      match /fixed_expenses/{expenseId} {
        allow read: if isOwner(userId) && isNotExpired(userId);
        allow create: if isOwner(userId) && isNotExpired(userId)
          && isString(request.resource.data.name)
          && isNumber(request.resource.data.amount)
          && isNumber(request.resource.data.dueDay);
        allow update: if isOwner(userId) && isNotExpired(userId)
          && isString(request.resource.data.name)
          && isNumber(request.resource.data.amount)
          && isNumber(request.resource.data.dueDay);
        allow delete: if isOwner(userId) && isNotExpired(userId);
      }

      match /saving_goals/{goalId} {
        allow read: if isOwner(userId) && isNotExpired(userId);
        allow create: if isOwner(userId) && isNotExpired(userId)
          && isString(request.resource.data.name)
          && isNumber(request.resource.data.targetAmount);
        allow update: if isOwner(userId) && isNotExpired(userId)
          && isString(request.resource.data.name)
          && isNumber(request.resource.data.targetAmount);
        allow delete: if isOwner(userId) && isNotExpired(userId);
      }

      match /savings_transactions/{transactionId} {
        allow read: if isOwner(userId) && isNotExpired(userId);
        allow create: if isOwner(userId) && isNotExpired(userId)
          && isNumber(request.resource.data.amount);
        allow update: if isOwner(userId) && isNotExpired(userId)
          && isNumber(request.resource.data.amount);
        allow delete: if isOwner(userId) && isNotExpired(userId);
      }

      match /bank_accounts/{accountId} {
        allow read: if isOwner(userId) && isNotExpired(userId);
        allow create: if isOwner(userId) && isNotExpired(userId)
          && isString(request.resource.data.name)
          && isString(request.resource.data.currency)
          && isValidCurrency(request.resource.data.currency)
          && isNumber(request.resource.data.balance);
        allow update: if isOwner(userId) && isNotExpired(userId)
          && isString(request.resource.data.name)
          && isString(request.resource.data.currency)
          && isValidCurrency(request.resource.data.currency)
          && isNumber(request.resource.data.balance);
        allow delete: if isOwner(userId) && isNotExpired(userId);
      }

      match /account_transactions/{transId} {
        allow read: if isOwner(userId) && isNotExpired(userId);
        allow create: if isOwner(userId) && isNotExpired(userId)
          && isNumber(request.resource.data.amount);
        allow update: if isOwner(userId) && isNotExpired(userId)
          && isNumber(request.resource.data.amount);
        allow delete: if isOwner(userId) && isNotExpired(userId);
      }

      match /categories/{categoryId} {
        allow read: if isOwner(userId) && isNotExpired(userId);
        allow create: if isOwner(userId) && isNotExpired(userId)
          && isString(request.resource.data.name);
        allow update: if isOwner(userId) && isNotExpired(userId)
          && isString(request.resource.data.name);
        allow delete: if isOwner(userId) && isNotExpired(userId);
      }
    }

    // ----------------------------------------
    // 💵 TRANSACCIONES - Ingresos y gastos
    // ----------------------------------------
    match /transactions/{transactionId} {
      allow read: if isOwnerFromResource();
      allow create: if isOwnerFromRequest()
        && isString(request.resource.data.description)
        && isNumber(request.resource.data.amount)
        && isValidType(request.resource.data.type)
        && isString(request.resource.data.currency)
        && isValidCurrency(request.resource.data.currency);
      allow update: if isOwnerFromResource() && isOwnerFromRequest() && keepsSameUserId()
        && isString(request.resource.data.description)
        && isNumber(request.resource.data.amount)
        && isValidType(request.resource.data.type)
        && isString(request.resource.data.currency)
        && isValidCurrency(request.resource.data.currency);
      allow delete: if isOwnerFromResource();
    }

    // ----------------------------------------
    // 🛒 LISTAS DE COMPRAS - Shopping lists
    // ----------------------------------------
    match /shopping_lists/{listId} {
      allow read: if isOwnerFromResource();
      allow create: if isOwnerFromRequest()
        && isString(request.resource.data.name);
      allow update: if isOwnerFromResource() && isOwnerFromRequest() && keepsSameUserId()
        && isString(request.resource.data.name);
      allow delete: if isOwnerFromResource();
    }

  }
}
