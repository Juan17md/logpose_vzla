rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ========================================
    // 🔐 HELPERS DE AUTORIZACIÓN
    // ========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnerFromResource() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isOwnerFromRequest() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function keepsSameUserId() {
      return request.resource.data.userId == resource.data.userId;
    }

    // ========================================
    // ✅ HELPERS DE VALIDACIÓN DE DATOS
    // ========================================
    function isString(value) {
      return value is string;
    }

    function isNumber(value) {
      return value is number;
    }

    function isBoolean(value) {
      return value is bool;
    }

    function isPositiveNumber(value) {
      return isNumber(value) && value > 0;
    }

    function isNonNegativeNumber(value) {
      return isNumber(value) && value >= 0;
    }

    function isStringMaxSize(value, maxLen) {
      return isString(value) && value.size() <= maxLen;
    }

    // Validación condicional: si el campo está presente en un update, debe tener el tipo/tamaño correcto.
    function validStringIfPresent(field) {
      return !(field in request.resource.data) || isString(request.resource.data[field]);
    }

    function validStringMaxSizeIfPresent(field, maxLen) {
      return !(field in request.resource.data)
        || isStringMaxSize(request.resource.data[field], maxLen);
    }

    function validNumberIfPresent(field) {
      return !(field in request.resource.data) || isNumber(request.resource.data[field]);
    }

    function validPositiveNumberIfPresent(field) {
      return !(field in request.resource.data)
        || isPositiveNumber(request.resource.data[field]);
    }

    function validNonNegativeIfPresent(field) {
      return !(field in request.resource.data)
        || isNonNegativeNumber(request.resource.data[field]);
    }

    function validBooleanIfPresent(field) {
      return !(field in request.resource.data) || isBoolean(request.resource.data[field]);
    }

    function isValidType(type) {
      return type == "ingreso" || type == "gasto" || type == "transferencia";
    }

    function isValidDebtType(type) {
      return type == "por_cobrar" || type == "por_pagar";
    }

    function isValidCategoryType(type) {
      return type == "ingreso" || type == "gasto" || type == "ambas";
    }

    function isValidTransactionCurrency(currency) {
      return currency == "VES" || currency == "USD";
    }

    function isValidAccountCurrency(currency) {
      return currency == "BS" || currency == "USD" || currency == "EUR" || currency == "USDT";
    }

    function validTypeIfPresent() {
      return !("type" in request.resource.data)
        || (isString(request.resource.data.type) && isValidType(request.resource.data.type));
    }

    function validDebtTypeIfPresent() {
      return !("type" in request.resource.data)
        || (isString(request.resource.data.type) && isValidDebtType(request.resource.data.type));
    }

    function validCategoryTypeIfPresent() {
      return !("tipo" in request.resource.data)
        || (isString(request.resource.data.tipo) && isValidCategoryType(request.resource.data.tipo));
    }

    function validTransactionCurrencyIfPresent() {
      return !("currency" in request.resource.data)
        || (isString(request.resource.data.currency)
            && isValidTransactionCurrency(request.resource.data.currency));
    }

    function validAccountCurrencyIfPresent() {
      return !("moneda" in request.resource.data)
        || (isString(request.resource.data.moneda)
            && isValidAccountCurrency(request.resource.data.moneda));
    }

    function validDueDayIfPresent() {
      return !("dueDay" in request.resource.data)
        || (isNumber(request.resource.data.dueDay)
            && request.resource.data.dueDay >= 1
            && request.resource.data.dueDay <= 31);
    }

    function validPaymentsSizeIfPresent() {
      return !("payments" in request.resource.data)
        || (request.resource.data.payments is list
            && request.resource.data.payments.size() <= 100);
    }

    // ========================================
    // 🛡️ HELPERS DE RBAC
    // ========================================
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function hasRole(userId, role) {
      return isSignedIn() && getUserData(userId).role == role;
    }

    function isAdmin() {
      return isSignedIn() && hasRole(request.auth.uid, "admin");
    }

    // El rol no puede mutar desde el SDK cliente (ni el dueño ni un admin).
    // Promociones y degradaciones: Server Actions con service account (omite rules).
    function keepsSameRole() {
      return request.resource.data.role == resource.data.role;
    }

    // ========================================
    // 📋 REGLAS DE SEGURIDAD - LOGPOSE VZLA
    // ========================================

    // ----------------------------------------
    // 👤 USUARIOS - Documento principal del usuario
    // ----------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && isStringMaxSize(request.resource.data.email, 150)
        && isStringMaxSize(request.resource.data.displayName, 100)
        && request.resource.data.role == "usuario";
allow update: if isOwner(userId)
          && keepsSameRole()
          && keepsSameUserId()
          && validStringMaxSizeIfPresent("displayName", 100);
      allow delete: if isAdmin();

      // ----------------------------------------
      // 🏦 CUENTAS BANCARIAS - users/{userId}/bank_accounts
      // ----------------------------------------
      match /bank_accounts/{accountId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isStringMaxSize(request.resource.data.nombre, 100)
          && isStringMaxSize(request.resource.data.banco, 100)
          && isString(request.resource.data.moneda)
          && isValidAccountCurrency(request.resource.data.moneda)
          && isNumber(request.resource.data.saldo)
          && isStringMaxSize(request.resource.data.color, 30)
          && isBoolean(request.resource.data.activa);
        allow update: if isOwner(userId)
          && validStringMaxSizeIfPresent("nombre", 100)
          && validStringMaxSizeIfPresent("banco", 100)
          && validAccountCurrencyIfPresent()
          && validNumberIfPresent("saldo")
          && validStringMaxSizeIfPresent("color", 30)
          && validBooleanIfPresent("activa")
          && validBooleanIfPresent("excluirDelTotal");
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // 💸 OPERACIONES DE CUENTA - users/{userId}/account_transactions
      // ----------------------------------------
      match /account_transactions/{transId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isString(request.resource.data.cuentaOrigenId)
          && isString(request.resource.data.tipo)
          && isPositiveNumber(request.resource.data.monto)
          && isString(request.resource.data.moneda)
          && isValidAccountCurrency(request.resource.data.moneda);
        allow update: if isOwner(userId)
          && validStringIfPresent("cuentaOrigenId")
          && validStringIfPresent("tipo")
          && validPositiveNumberIfPresent("monto")
          && validAccountCurrencyIfPresent();
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // 🗂️ CATEGORÍAS - users/{userId}/categories
      // ----------------------------------------
      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isStringMaxSize(request.resource.data.nombre, 100)
          && isString(request.resource.data.tipo)
          && isValidCategoryType(request.resource.data.tipo)
          && validStringMaxSizeIfPresent("icono", 50)
          && validStringMaxSizeIfPresent("color", 30);
        allow update: if isOwner(userId)
          && validStringMaxSizeIfPresent("nombre", 100)
          && validCategoryTypeIfPresent()
          && validStringMaxSizeIfPresent("icono", 50)
          && validStringMaxSizeIfPresent("color", 30)
          && validBooleanIfPresent("esPredeterminada");
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // 💳 DEUDAS - users/{userId}/debts
      // ----------------------------------------
      match /debts/{debtId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isStringMaxSize(request.resource.data.personName, 100)
          && isPositiveNumber(request.resource.data.amount)
          && isString(request.resource.data.type)
          && isValidDebtType(request.resource.data.type)
          && validTransactionCurrencyIfPresent()
          && validPaymentsSizeIfPresent();
        allow update: if isOwner(userId)
          && validStringMaxSizeIfPresent("personName", 100)
          && validPositiveNumberIfPresent("amount")
          && validDebtTypeIfPresent()
          && validBooleanIfPresent("isPaid")
          && validTransactionCurrencyIfPresent()
          && validPaymentsSizeIfPresent();
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // 💼 GASTOS FIJOS - users/{userId}/fixed_expenses
      // ----------------------------------------
      match /fixed_expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isStringMaxSize(request.resource.data.title, 100)
          && isPositiveNumber(request.resource.data.amount)
          && isNumber(request.resource.data.dueDay)
          && request.resource.data.dueDay >= 1
          && request.resource.data.dueDay <= 31
          && validTransactionCurrencyIfPresent()
          && validStringMaxSizeIfPresent("category", 100)
          && validStringMaxSizeIfPresent("description", 500);
        allow update: if isOwner(userId)
          && validStringMaxSizeIfPresent("title", 100)
          && validPositiveNumberIfPresent("amount")
          && validDueDayIfPresent()
          && validTransactionCurrencyIfPresent()
          && validStringMaxSizeIfPresent("category", 100)
          && validStringMaxSizeIfPresent("description", 500);
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // 🎯 METAS DE AHORRO - users/{userId}/saving_goals
      // ----------------------------------------
      match /saving_goals/{goalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isStringMaxSize(request.resource.data.name, 100)
          && isPositiveNumber(request.resource.data.targetAmount)
          && validNonNegativeIfPresent("currentAmount")
          && validStringMaxSizeIfPresent("color", 30);
        allow update: if isOwner(userId)
          && validStringMaxSizeIfPresent("name", 100)
          && validPositiveNumberIfPresent("targetAmount")
          && validNonNegativeIfPresent("currentAmount")
          && validStringMaxSizeIfPresent("color", 30);
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // 🏦 MOVIMIENTOS DE AHORRO - users/{userId}/savings_transactions
      // ----------------------------------------
      match /savings_transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isPositiveNumber(request.resource.data.amount);
        allow update: if isOwner(userId)
          && validPositiveNumberIfPresent("amount")
          && validStringIfPresent("type")
          && validStringIfPresent("method");
        allow delete: if isOwner(userId);
      }
    }

    // ----------------------------------------
    // 💵 TRANSACCIONES - Ingresos y gastos (colección raíz)
    // ----------------------------------------
    match /transactions/{transactionId} {
      allow read: if isOwnerFromResource();
      allow create: if isOwnerFromRequest()
        && isPositiveNumber(request.resource.data.amount)
        && isValidType(request.resource.data.type)
        && isStringMaxSize(request.resource.data.category, 100)
        && isStringMaxSize(request.resource.data.description, 500)
        && isString(request.resource.data.currency)
        && isValidTransactionCurrency(request.resource.data.currency);
      allow update: if isOwnerFromResource() && isOwnerFromRequest() && keepsSameUserId()
        && validPositiveNumberIfPresent("amount")
        && validTypeIfPresent()
        && validStringMaxSizeIfPresent("category", 100)
        && validStringMaxSizeIfPresent("description", 500)
        && validTransactionCurrencyIfPresent();
      allow delete: if isOwnerFromResource();
    }

    // ----------------------------------------
    // 📋 LOGS DE ADMINISTRACIÓN - Auditoría
    // ----------------------------------------
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && isStringMaxSize(request.resource.data.action, 100)
        && isStringMaxSize(request.resource.data.adminUid, 128)
        && isStringMaxSize(request.resource.data.adminEmail, 150)
        && isStringMaxSize(request.resource.data.targetUid, 128)
        && isStringMaxSize(request.resource.data.targetEmail, 150)
        && isStringMaxSize(request.resource.data.details, 1000)
        && isStringMaxSize(request.resource.data.timestamp, 50);
    }

    // ----------------------------------------
    // 🛒 LISTAS DE COMPRAS - Shopping lists (colección raíz)
    // ----------------------------------------
    match /shopping_lists/{listId} {
      allow read: if isOwnerFromResource();
      allow create: if isOwnerFromRequest()
        && isStringMaxSize(request.resource.data.name, 100);
      allow update: if isOwnerFromResource() && isOwnerFromRequest() && keepsSameUserId()
        && validStringMaxSizeIfPresent("name", 100);
      allow delete: if isOwnerFromResource();
    }

  }
}
